<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.stela.SandboxPatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/private/var/db/org.stela.SandboxPatch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/org.stela.SandboxPatch.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/org.stela.SandboxPatch.log</string>
</dict>
</plist>
